{
    "compilerOptions":
    {
        "types":
        [
            "node"
        ],
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "isolatedDeclarations": true,
        "noImplicitOverride": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "verbatimModuleSyntax": true,
        "useUnknownInCatchVariables": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./dist",
        "lib":
        [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "paths":
        {
            "azerothjs":
            [
                "./packages/azerothjs/src/index.ts"
            ],
            "azerothjs/internal":
            [
                "./packages/azerothjs/src/internal.ts"
            ],
            "@azerothjs/schema":
            [
                "./packages/schema/src/index.ts"
            ],
            "@azerothjs/cron":
            [
                "./packages/cron/src/index.ts"
            ],
            "@azerothjs/logger":
            [
                "./packages/logger/src/index.ts"
            ],
            "@azerothjs/http":
            [
                "./packages/http/src/index.ts"
            ],
            "@azerothjs/http/node":
            [
                "./packages/http/src/node.ts"
            ],
            "@azerothjs/ws":
            [
                "./packages/ws/src/index.ts"
            ],
            "@azerothjs/kit": ["./packages/kit/src/index.ts"],
            "@azerothjs/kit/ssr": ["./packages/kit/src/ssr.ts"],
            "@azerothjs/kit/prerender": ["./packages/kit/src/prerender.ts"],
            "@azerothjs/kit/client": ["./packages/kit/src/client.ts"],
            "@azerothjs/http/api": ["./packages/http/src/api/index.ts"],
            "@azerothjs/http/api/client": ["./packages/http/src/api/client-entry.ts"],
            "@azerothjs/compiler":
            [
                "./packages/compiler/src/index.ts"
            ],
            "@azerothjs/language-server/language-service": [
                "./packages/language-server/src/language-service/index.ts"
            ],
            "@azerothjs/language-server":
            [
                "./packages/language-server/src/index.ts"
            ],
            "@azerothjs/testing":
            [
                "./packages/testing/src/index.ts"
            ],
            "@azerothjs/devtools":
            [
                "./packages/devtools/src/index.ts"
            ],
            "@azerothjs/eslint-plugin":
            [
                "./packages/eslint-plugin/src/index.ts"
            ]
        }
    },
    "include":
    [
        "packages/*/src/**/*",
        "packages/*/tests/**/*"
    ],
    "exclude":
    [
        "node_modules",
        "dist",
        "packages/*/dist",
        // CommonJS tsserver plugin (`export = init`), bundled by its own esbuild
        // step, not tsc - it cannot be type-checked under `module: ESNext`.
        "packages/typescript-plugin"
    ]
}
