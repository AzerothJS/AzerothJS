{
    "name": "@azerothjs/devtools",
    "version": "1.1.0",
    "engines": {
        "node": ">=22"
    },
    "description": "AzerothJS devtools - the in-page reactive inspector (components, timeline, graph, performance, server bridge) plus an embeddable agent",
    "keywords": [
        "azerothjs",
        "devtools",
        "inspector",
        "debugging",
        "reactivity",
        "timeline"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js",
            "default": "./dist/server.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.map"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "node ../../scripts/tsc7.mjs -p tsconfig.build.json",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "azerothjs": "^1.1.0",
        "@azerothjs/ws": "^1.1.0"
    },
    "peerDependenciesMeta": {
        "@azerothjs/ws": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "author": {
        "name": "IntelligentQuantum",
        "email": "IntelligentQuantum@Gmail.Com",
        "url": "https://IntelligentQuantum.Dev/"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AzerothJS/AzerothJS.git",
        "directory": "packages/devtools"
    },
    "homepage": "https://github.com/AzerothJS/AzerothJS/tree/main/packages/devtools",
    "bugs": {
        "url": "https://github.com/AzerothJS/AzerothJS/issues"
    }
}
