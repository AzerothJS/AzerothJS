{
    "name": "@azerothjs/http",
    "version": "2.1.0-beta.1",
    "engines": {
        "node": ">=22"
    },
    "description": "AzerothJS server kernel - web-standard Request/Response HTTP stack (no third-party dependencies) where every request is a reactive root",
    "keywords": [
        "azerothjs",
        "http",
        "server",
        "fetch",
        "request-response",
        "zero-dependency"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/node.d.ts",
            "import": "./dist/node.js",
            "default": "./dist/node.js"
        },
        "./api": {
            "types": "./dist/api/index.d.ts",
            "import": "./dist/api/index.js",
            "default": "./dist/api/index.js"
        },
        "./api/shared": {
            "types": "./dist/api/shared-entry.d.ts",
            "import": "./dist/api/shared-entry.js",
            "default": "./dist/api/shared-entry.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "docs",
        "!dist/**/*.map"
    ],
    "sideEffects": false,
    "scripts": {
        "clean": "node ../../scripts/clean.mjs dist",
        "prebuild": "npm run clean",
        "build": "node ../../scripts/tsc7.mjs -p tsconfig.build.json",
        "prepack": "node ../../scripts/prepack.mjs"
    },
    "dependencies": {
        "@azerothjs/logger": "^2.1.0-beta.1",
        "@azerothjs/schema": "^2.1.0-beta.1"
    },
    "peerDependencies": {
        "azerothjs": "^2.1.0-beta.1"
    },
    "publishConfig": {
        "access": "public"
    },
    "author": {
        "name": "IntelligentQuantum",
        "email": "IntelligentQuantum@Gmail.Com",
        "url": "https://IntelligentQuantum.Dev/"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AzerothJS/AzerothJS.git",
        "directory": "packages/http"
    },
    "homepage": "https://github.com/AzerothJS/AzerothJS/tree/main/packages/http",
    "bugs": {
        "url": "https://github.com/AzerothJS/AzerothJS/issues"
    },
    "devDependencies": {
        "@seriousme/openapi-schema-validator": "^2.9.1"
    }
}
