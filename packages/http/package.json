{
    "name": "@azerothjs/http",
    "version": "1.0.0-beta.2",
    "engines": {
        "node": ">=24"
    },
    "description": "AzerothJS server kernel - zero-dependency, web-standard Request/Response HTTP stack where every request is a reactive root",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/node.d.ts",
            "import": "./dist/node.js",
            "default": "./dist/node.js"
        },
        "./api": {
            "types": "./dist/api/index.d.ts",
            "import": "./dist/api/index.js",
            "default": "./dist/api/index.js"
        },
        "./api/client": {
            "types": "./dist/api/client-entry.d.ts",
            "import": "./dist/api/client-entry.js",
            "default": "./dist/api/client-entry.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "clean": "node ../../scripts/clean.mjs dist",
        "prebuild": "npm run clean",
        "build": "node ../../scripts/tsc7.mjs -p tsconfig.build.json",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@azerothjs/logger": "1.0.0-beta.2",
        "azerothjs": "1.0.0-beta.2",
        "@azerothjs/schema": "1.0.0-beta.2"
    },
    "publishConfig": {
        "access": "public"
    },
    "author": {
        "name": "IntelligentQuantum",
        "email": "IntelligentQuantum@Gmail.Com",
        "url": "https://IntelligentQuantum.Dev/"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AzerothJS/AzerothJS.git",
        "directory": "packages/http"
    },
    "homepage": "https://github.com/AzerothJS/AzerothJS/tree/main/packages/http",
    "bugs": {
        "url": "https://github.com/AzerothJS/AzerothJS/issues"
    }
}
