{
    "name": "azerothjs",
    "version": "1.1.0",
    "engines": {
        "node": ">=22"
    },
    "description": "The AzerothJS frontend framework: fine-grained reactivity, compiled .azeroth components, control flow, SSR + islands, router, and forms - one package.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./internal": {
            "types": "./dist/internal.d.ts",
            "import": "./dist/internal.js",
            "default": "./dist/internal.js"
        },
        "./semantics": {
            "types": "./dist/semantics.d.ts",
            "import": "./dist/semantics.js",
            "default": "./dist/semantics.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.map"
    ],
    "sideEffects": false,
    "scripts": {
        "clean": "node ../../scripts/clean.mjs dist",
        "prebuild": "npm run clean",
        "build": "node ../../scripts/tsc7.mjs -p tsconfig.build.json",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@azerothjs/schema": "^1.1.0"
    },
    "keywords": [
        "framework",
        "reactive",
        "signals",
        "fine-grained",
        "no-vdom",
        "dom",
        "typescript",
        "frontend",
        "azeroth"
    ],
    "publishConfig": {
        "access": "public"
    },
    "author": {
        "name": "IntelligentQuantum",
        "email": "IntelligentQuantum@Gmail.Com",
        "url": "https://IntelligentQuantum.Dev/"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AzerothJS/AzerothJS.git",
        "directory": "packages/azerothjs"
    },
    "homepage": "https://github.com/AzerothJS/AzerothJS#readme",
    "bugs": {
        "url": "https://github.com/AzerothJS/AzerothJS/issues"
    }
}
