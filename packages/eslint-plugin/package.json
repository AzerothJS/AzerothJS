{
    "name": "@azerothjs/eslint-plugin",
    "version": "2.0.0-beta.2",
    "description": "AzerothJS ESLint rules - reactivity foot-guns in plain .ts files",
    "keywords": [
        "azerothjs",
        "eslint",
        "eslint-plugin",
        "linting",
        "reactivity"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.map"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "node ../../scripts/tsc7.mjs -p tsconfig.build.json",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@azerothjs/compiler": "^2.0.0-beta.2",
        "@azerothjs/language-server": "^2.0.0-beta.2"
    },
    "peerDependencies": {
        "@typescript-eslint/parser": ">=8",
        "azerothjs": "^2.0.0-beta.2",
        "eslint": ">=9",
        "typescript": ">=5 <7"
    },
    "peerDependenciesMeta": {
        "typescript": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "author": {
        "name": "IntelligentQuantum",
        "email": "IntelligentQuantum@Gmail.Com",
        "url": "https://IntelligentQuantum.Dev/"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AzerothJS/AzerothJS.git",
        "directory": "packages/eslint-plugin"
    },
    "homepage": "https://github.com/AzerothJS/AzerothJS/tree/main/packages/eslint-plugin",
    "bugs": {
        "url": "https://github.com/AzerothJS/AzerothJS/issues"
    }
}
