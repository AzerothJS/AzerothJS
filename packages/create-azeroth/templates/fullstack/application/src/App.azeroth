// The shell: one router over the ONE route table (src/routes.ts). The optional
// props are the SSR seam - `url` pins a memory history when the kit renders
// server-side; `handoff` seeds loader data so the hydrating client never refetches
// what the server just loaded. The browser omits both and the router reads the
// address bar.
import { RouterProvider, Routes, Link, createRouter, createMemoryHistory } from 'azerothjs';
import type { LoaderHandoff } from 'azerothjs';
import { routes } from './routes.ts';

export default component App(props: { url?: string; handoff?: LoaderHandoff })
{
    const router = createRouter({
        routes,
        history: props.url !== undefined ? createMemoryHistory(props.url) : undefined,
        initialLoaderData: props.handoff
    });

    <RouterProvider router={ router }>
        <div class="app">
            <nav>
                <span class="brand">&#9650; {{name}}</span>
                <Link to="/" activeClass="active" end>Home</Link>
                <Link to="/guestbook" activeClass="active">Guest book</Link>
            </nav>
            <main>
                <Routes fallback={ () => <h1>Not found</h1> } />
            </main>
        </div>
    </RouterProvider>
}
