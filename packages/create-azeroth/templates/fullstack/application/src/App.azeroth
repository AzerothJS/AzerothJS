// The shell: one router, two routes, client-side navigation. The optional `url`
// prop is the SSR seam - the prerender script renders App at a fixed URL through a
// memory history; the browser omits it and the router reads the address bar.
import { RouterProvider, Routes, Link, createRouter, createMemoryHistory } from 'azerothjs';
import Home from './pages/home.azeroth';
import GuestBook from './pages/guest-book.azeroth';

export default component App(props: { url?: string })
{
    const router = createRouter({
        routes: [
            { path: '/', component: Home },
            { path: '/guestbook', component: GuestBook }
        ],
        history: props.url !== undefined ? createMemoryHistory(props.url) : undefined
    });

    <RouterProvider router={ router }>
        <div class="app">
            <nav>
                <Link to="/" activeClass="active" end>Home</Link>
                <Link to="/guestbook" activeClass="active">Guest book</Link>
            </nav>
            <main>
                <Routes fallback={ () => <h1>Not found</h1> } />
            </main>
        </div>
    </RouterProvider>
}
