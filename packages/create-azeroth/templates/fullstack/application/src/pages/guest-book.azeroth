// One schema, three enforcement points: it validates this form in the browser, the typed
// client call before the wire, and the server boundary. The route's loader calls that same
// client on the server, so the list is already in the served bytes and `useLoader` reads it
// here; `form` owns the fields, the errors, and the submit lifecycle. The submit is a SERVER
// ACTION: a directly-callable typed function, CSRF-guarded server-side, whose validation
// failures land back on these fields through applyFieldErrors.
import { useLoader } from 'azerothjs';
import { applyFieldErrors, client, entryInput, type Entry } from '../api.ts';

export default component GuestBook()
{
    const entries = useLoader<Entry[]>();

    form sign = { name: '', message: '' } with
    {
        schema: entryInput,
        onSubmit: async (values) =>
        {
            try
            {
                await client.guestbook.sign(values);
                sign.reset();
                // The server owns the list, so re-read it rather than guessing what it now holds.
                void entries.refetch();
            }
            catch (error)
            {
                // A 422's field map lands on the form; anything else is a transport problem.
                if (!applyFieldErrors(sign, error))
                {
                    sign.setError('message', 'Could not reach the server - try again.');
                }
            }
        }
    };

    <section class="page">
        <h1>Guest book</h1>
        <p class="claim">
            One schema validates this form, the typed client call, and the server
            boundary. Submit with a short name to watch the same rule answer from
            the browser first.
        </p>
        <form onSubmit={ sign.handleSubmit }>
            <label>
                Name
                <input bind:value={ sign.name } placeholder="Jaina" />
                <Show when={ sign.touched().name && sign.errors().name }>
                    <small class="error">{ sign.errors().name }</small>
                </Show>
            </label>
            <label>
                Message
                <input bind:value={ sign.message } placeholder="Well met!" />
                <Show when={ sign.touched().message && sign.errors().message }>
                    <small class="error">{ sign.errors().message }</small>
                </Show>
            </label>
            <button type="submit" disabled={ sign.submitting() }>
                { sign.submitting() ? 'Signing...' : 'Sign' }
            </button>
        </form>
        <Switch>
            <Match when={ entries.loading() }>
                <p class="muted">Loading entries...</p>
            </Match>
            <Match when={ entries.error() }>
                <p class="error">
                    Could not load entries.
                    <button class="retry" onClick={ () => void entries.refetch() }>Retry</button>
                </p>
            </Match>
            <Match when={ entries.data()?.length === 0 }>
                <p class="muted">No entries yet - be the first.</p>
            </Match>
        </Switch>
        <ul class="entries">
            <For each={ entries.data() ?? [] } key={ (item) => item.id } let={ item }>
                <li>
                    <strong>{ item.name }</strong>
                    <span>{ item.message }</span>
                </li>
            </For>
        </ul>
    </section>
}
