// One schema, three enforcement points: it validates this form in the browser, the typed
// client call before the wire, and the server boundary. `mount { }` loads the list once the
// page is connected; `form` owns the fields, the errors, and the submit lifecycle.
import { client, entryInput, type Entry } from '../api.ts';

export default component GuestBook()
{
    state entries: Entry[] = [];
    state phase: 'loading' | 'ready' | 'failed' = 'loading';

    const load = async (): Promise<void> =>
    {
        phase = 'loading';
        try
        {
            entries = await client.guestbook.list();
            phase = 'ready';
        }
        catch
        {
            phase = 'failed';
        }
    };

    mount
    {
        void load();
    }

    form sign = { name: '', message: '' } with
    {
        schema: entryInput,
        onSubmit: async (values) =>
        {
            try
            {
                const created = await client.guestbook.sign({ input: values });
                entries = [created, ...entries];
                sign.reset();
            }
            catch
            {
                sign.setError('message', 'Could not reach the server - try again.');
            }
        }
    };

    <section class="page">
        <h1>Guest book</h1>
        <p class="claim">
            One schema validates this form, the typed client call, and the server
            boundary. Submit with a short name to watch the same rule answer from
            the browser first.
        </p>
        <form onSubmit={ sign.handleSubmit }>
            <label>
                Name
                <input bind:value={ sign.name } placeholder="Jaina" />
                <Show when={ sign.touched().name && sign.errors().name }>
                    <small class="error">{ sign.errors().name }</small>
                </Show>
            </label>
            <label>
                Message
                <input bind:value={ sign.message } placeholder="Well met!" />
                <Show when={ sign.touched().message && sign.errors().message }>
                    <small class="error">{ sign.errors().message }</small>
                </Show>
            </label>
            <button type="submit" disabled={ sign.submitting() }>
                { sign.submitting() ? 'Signing...' : 'Sign' }
            </button>
        </form>
        <Switch>
            <Match when={ phase === 'loading' }>
                <p class="muted">Loading entries...</p>
            </Match>
            <Match when={ phase === 'failed' }>
                <p class="error">
                    Could not load entries.
                    <button class="retry" onClick={ () => void load() }>Retry</button>
                </p>
            </Match>
            <Match when={ entries.length === 0 }>
                <p class="muted">No entries yet - be the first.</p>
            </Match>
        </Switch>
        <ul class="entries">
            <For each={ entries } key={ (item) => item.id } let={ item }>
                <li>
                        <strong>{ item.name }</strong>
                        <span>{ item.message }</span>
                    </li>
            </For>
        </ul>
    </section>
}
