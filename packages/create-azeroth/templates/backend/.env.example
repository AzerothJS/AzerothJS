# Copy to .env for local overrides (never commit .env). Every variable here is read
# by the loadConfig block in src/main.ts - keep the two in sync.
PORT=3000
# Left unset on purpose. `azeroth dev` declares NODE_ENV=development for its children, and
# anything else is a deploy - where `dev: true` would expose thrown-error messages and stack
# traces. Set it only to force a mode.
# NODE_ENV=development
