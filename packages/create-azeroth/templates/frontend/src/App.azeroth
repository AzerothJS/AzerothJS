export default component App()
{
    state count = 0;
    derived parity = count % 2 === 0 ? 'even' : 'odd';
    derived doubled = count * 2;

    <main class="app">
        <p class="brand"><img class="brand-mark" src="/favicon-32.png" alt=""/> azerothjs</p>
        <h1>{{name}}</h1>
        <p class="claim">
            Fine-grained reactivity, compiled. Click the state cell: the update
            walks the graph below and lands on exact DOM nodes - no virtual DOM,
            no re-render.
        </p>

        <div class="signals">
            <button class="cell is-state" onClick={ () => count += 1 }>
                <span class="keyword">state</span>
                <code>count = { count }</code>
            </button>
            <span class="flow" aria-hidden="true">-&gt;</span>
            <div class="cell">
                <span class="keyword">derived</span>
                <code>parity = { parity }</code>
            </div>
            <span class="flow" aria-hidden="true">-&gt;</span>
            <div class="cell">
                <span class="keyword">derived</span>
                <code>doubled = { doubled }</code>
            </div>
        </div>
        <p class="hint">src/App.azeroth owns everything above - edit it and save.</p>

        <ul class="next">
            <li><code>npm test</code><span>component tests over real DOM</span></li>
            <li><code>npm run check</code><span>typecheck + lint every component</span></li>
            <li><code>npm run build</code><span>static dist/ for any host</span></li>
            <li><a href="https://github.com/AzerothJS/AzerothJS">docs and examples</a></li>
        </ul>
    </main>
}
