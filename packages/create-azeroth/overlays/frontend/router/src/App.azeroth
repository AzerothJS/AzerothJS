// The shell: one router over the ONE route table (src/routes.ts). `<Link>` swaps
// pages client-side - no reload, the URL updates, back/forward work. The optional
// `url` prop pins a memory history so tests render a specific route; the browser
// omits it and the router reads the address bar.
import { RouterProvider, Routes, Link, createRouter, createMemoryHistory } from 'azerothjs';
import { routes } from './routes.ts';

export default component App(props: { url?: string })
{
    const router = createRouter({
        routes,
        history: props.url !== undefined ? createMemoryHistory(props.url) : undefined
    });

    <RouterProvider router={ router }>
        <div class="app">
            <nav>
                <span class="brand">&#9650; {{name}}</span>
                <Link to="/" activeClass="active" end>Home</Link>
                <Link to="/about" activeClass="active">About</Link>
            </nav>
            <main>
                <Routes fallback={ () => <h1>Not found</h1> } />
            </main>
        </div>
    </RouterProvider>
}
