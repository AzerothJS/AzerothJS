// The landing route. `state` declares a signal; each `derived` recomputes from
// it; the markup compiles to direct DOM updates. The cells below are this
// component's real reactive graph - click the state cell and only the three value
// text nodes change. Edit this file and save: the change is live.
export default component Home()
{
    state count = 0;
    derived parity = count % 2 === 0 ? 'even' : 'odd';
    derived doubled = count * 2;

    <section class="page">
        <h1>{{name}}</h1>
        <p class="claim">
            Fine-grained reactivity, compiled. Click the state cell: the update
            walks the graph below and lands on exact DOM nodes - no virtual DOM,
            no re-render.
        </p>

        <div class="signals">
            <button class="cell is-state" onClick={ () => count += 1 }>
                <span class="keyword">state</span>
                <code>count = { count }</code>
            </button>
            <span class="flow" aria-hidden="true">-&gt;</span>
            <div class="cell">
                <span class="keyword">derived</span>
                <code>parity = { parity }</code>
            </div>
            <span class="flow" aria-hidden="true">-&gt;</span>
            <div class="cell">
                <span class="keyword">derived</span>
                <code>doubled = { doubled }</code>
            </div>
        </div>
        <p class="hint">src/pages/home.azeroth owns everything above - edit it and save.</p>
    </section>
}
