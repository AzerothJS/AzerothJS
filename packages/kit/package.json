{
    "name": "@azerothjs/kit",
    "version": "1.1.0",
    "description": "The assembled car: per-route SSR, static prerendering, hydration, and one-command production builds over the AzerothJS router, renderer, and HTTP server.",
    "keywords": [
        "azerothjs",
        "meta-framework",
        "ssr",
        "prerender",
        "hydration"
    ],
    "homepage": "https://github.com/AzerothJS/AzerothJS/tree/main/packages/kit",
    "bugs": {
        "url": "https://github.com/AzerothJS/AzerothJS/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AzerothJS/AzerothJS.git",
        "directory": "packages/kit"
    },
    "license": "MIT",
    "author": {
        "name": "IntelligentQuantum",
        "email": "IntelligentQuantum@Gmail.Com",
        "url": "https://IntelligentQuantum.Dev/"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./ssr": {
            "types": "./dist/ssr.d.ts",
            "import": "./dist/ssr.js",
            "default": "./dist/ssr.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js",
            "default": "./dist/client.js"
        },
        "./prerender": {
            "types": "./dist/prerender.d.ts",
            "import": "./dist/prerender.js",
            "default": "./dist/prerender.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "azeroth-kit-prerender": "./dist/prerender-cli.js"
    },
    "files": [
        "dist",
        "!dist/**/*.map"
    ],
    "scripts": {
        "build": "node ../../scripts/tsc7.mjs -p tsconfig.build.json",
        "test": "vitest run",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@azerothjs/http": "^1.1.0"
    },
    "peerDependencies": {
        "azerothjs": "^1.1.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    },
    "sideEffects": false
}
