{
    "name": "@azerothjs/kit",
    "version": "1.0.0-beta.2",
    "description": "The assembled car: per-route SSR, static prerendering, hydration, and one-command production builds over the AzerothJS router, renderer, and HTTP server.",
    "keywords": [
        "azerothjs",
        "meta-framework",
        "ssr",
        "prerender",
        "hydration"
    ],
    "homepage": "https://github.com/AzerothJS/AzerothJS/tree/main/packages/kit",
    "bugs": "https://github.com/AzerothJS/AzerothJS/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AzerothJS/AzerothJS.git",
        "directory": "packages/kit"
    },
    "license": "MIT",
    "author": "IntelligentQuantum",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./ssr": {
            "types": "./dist/ssr.d.ts",
            "import": "./dist/ssr.js",
            "default": "./dist/ssr.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js",
            "default": "./dist/client.js"
        },
        "./prerender": {
            "types": "./dist/prerender.d.ts",
            "import": "./dist/prerender.js",
            "default": "./dist/prerender.js"
        }
    },
    "bin": {
        "azeroth-kit-prerender": "./dist/prerender-cli.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node ../../scripts/tsc7.mjs -p tsconfig.build.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@azerothjs/http": "1.0.0-beta.2",
        "azerothjs": "1.0.0-beta.2"
    },
    "engines": {
        "node": ">=24"
    }
}
