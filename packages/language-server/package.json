{
    "name": "@azerothjs/language-server",
    "version": "1.1.0",
    "description": "AzerothJS language server - a Language Server Protocol front-end for .azeroth files",
    "keywords": [
        "azerothjs",
        "language-server",
        "lsp",
        "editor",
        "tooling",
        "intellisense"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "azeroth-language-server": "./dist/cli.js",
        "azeroth-tsc": "./dist/tsc-cli.js",
        "azeroth-docgen": "./dist/docgen-cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./cli": "./dist/cli.js",
        "./tsc": "./dist/tsc.js",
        "./docgen": "./dist/docgen-cli.js",
        "./language-service": {
            "types": "./dist/language-service/index.d.ts",
            "import": "./dist/language-service/index.js",
            "default": "./dist/language-service/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "dependencies": {
        "typescript": ">=6 <7",
        "vscode-languageserver": "^10",
        "vscode-languageserver-textdocument": "^1",
        "@azerothjs/compiler": "^1.1.0",
        "vscode-css-languageservice": "^6",
        "vscode-html-languageservice": "^5"
    },
    "scripts": {
        "build": "node ../../scripts/tsc7.mjs -p tsconfig.build.json",
        "prepublishOnly": "npm run build"
    },
    "publishConfig": {
        "access": "public"
    },
    "author": {
        "name": "IntelligentQuantum",
        "email": "IntelligentQuantum@Gmail.Com",
        "url": "https://IntelligentQuantum.Dev/"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AzerothJS/AzerothJS.git",
        "directory": "packages/language-server"
    },
    "homepage": "https://github.com/AzerothJS/AzerothJS/tree/main/packages/language-server",
    "bugs": {
        "url": "https://github.com/AzerothJS/AzerothJS/issues"
    },
    "peerDependencies": {
        "azerothjs": "^1.1.0"
    }
}
