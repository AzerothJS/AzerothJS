{
    "compilerOptions":
    {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ESNext", "DOM"],
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "isolatedDeclarations": true,
        "noEmit": true
    }
}
