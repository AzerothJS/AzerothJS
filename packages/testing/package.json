{
    "name": "@azerothjs/testing",
    "version": "2.0.0-beta.2",
    "engines": {
        "node": ">=22"
    },
    "description": "AzerothJS testing utilities - auto-disposing mounts, subscriber leak guards, event helpers",
    "keywords": [
        "azerothjs",
        "testing",
        "test-utils",
        "components",
        "vitest"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.map"
    ],
    "sideEffects": false,
    "scripts": {
        "clean": "node ../../scripts/clean.mjs dist",
        "prebuild": "npm run clean",
        "build": "node ../../scripts/tsc7.mjs -p tsconfig.build.json",
        "prepack": "node ../../scripts/prepack.mjs"
    },
    "peerDependencies": {
        "azerothjs": "^2.0.0-beta.2"
    },
    "publishConfig": {
        "access": "public"
    },
    "author": {
        "name": "IntelligentQuantum",
        "email": "IntelligentQuantum@Gmail.Com",
        "url": "https://IntelligentQuantum.Dev/"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AzerothJS/AzerothJS.git",
        "directory": "packages/testing"
    },
    "homepage": "https://github.com/AzerothJS/AzerothJS/tree/main/packages/testing",
    "bugs": {
        "url": "https://github.com/AzerothJS/AzerothJS/issues"
    }
}
