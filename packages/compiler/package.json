{
    "name": "@azerothjs/compiler",
    "version": "1.0.0",
    "engines": {
        "node": ">=22"
    },
    "description": "AzerothJS compiler - .azeroth single-file-component compiler (markup to h() calls) and Vite plugin",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./azeroth.tmLanguage.json": "./syntaxes/azeroth.tmLanguage.json"
    },
    "files": [
        "dist",
        "syntaxes",
        "GRAMMAR.md",
        "STABILITY.md"
    ],
    "sideEffects": false,
    "dependencies": {
        "@azerothjs/logger": "1.0.0"
    },
    "peerDependencies": {
        "azerothjs": "^1.0.0",
        "vite": ">=8",
        "typescript": ">=5 <7"
    },
    "peerDependenciesMeta": {
        "azerothjs": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "scripts": {
        "clean": "node ../../scripts/clean.mjs dist",
        "prebuild": "npm run clean",
        "build": "node ../../scripts/tsc7.mjs -p tsconfig.build.json",
        "prepublishOnly": "npm run build"
    },
    "publishConfig": {
        "access": "public"
    },
    "author": {
        "name": "IntelligentQuantum",
        "email": "IntelligentQuantum@Gmail.Com",
        "url": "https://IntelligentQuantum.Dev/"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AzerothJS/AzerothJS.git",
        "directory": "packages/compiler"
    },
    "homepage": "https://github.com/AzerothJS/AzerothJS/tree/main/packages/compiler",
    "bugs": {
        "url": "https://github.com/AzerothJS/AzerothJS/issues"
    }
}
